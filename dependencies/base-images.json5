{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "dependencies: base images",
  packageRules: [
    {
      description: "base images: automerge non major versions",
      matchDepNames: [
        "busybox",
        "curlimages/curl",
        "google/cloud-sdk",
        "nginx",
      ],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "base images: automerge major versions",
      matchDepNames: ["google/cloud-sdk"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
    },
  ],
}
